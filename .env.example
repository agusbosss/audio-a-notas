# Copiar a `.env` y completar. `.env` no se versiona.

# https://www.assemblyai.com/dashboard → API Keys
ASSEMBLYAI_API_KEY=

# Opcionales (estos son los valores por defecto)
# MOTOR=assemblyai
# CARPETA_ENTRADA=~/Library/Mobile Documents/com~apple~CloudDocs/Transcribir
# CARPETA_SALIDA=./salida
# Vacío usa el modelo por defecto de Claude Code. Por ejemplo: sonnet
# CLAUDE_MODELO=
